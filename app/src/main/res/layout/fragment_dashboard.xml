<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingHorizontal="@dimen/spacing_screen_horizontal"
    android:paddingTop="@dimen/spacing_screen_vertical"
    android:paddingBottom="@dimen/spacing_screen_bottom">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/spacing_tight">

        <LinearLayout
            android:id="@+id/container_dashboard_investment_plans"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_section"
            android:paddingHorizontal="@dimen/spacing_tight"
            android:text="@string/dashboard_section_investments"
            android:textAppearance="@style/TextAppearance.Urbanfix.Title" />

        <LinearLayout
            android:id="@+id/container_investments"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_block"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_section"
            android:paddingHorizontal="@dimen/spacing_tight"
            android:text="@string/dashboard_section_public_spending"
            android:textAppearance="@style/TextAppearance.Urbanfix.Title" />

        <LinearLayout
            android:id="@+id/container_spending"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_block"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
