<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.home.HomeFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/spacing_screen_horizontal"
        android:paddingTop="@dimen/spacing_screen_vertical">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingVertical="@dimen/spacing_tight"
            android:scrollbars="none">

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggle_issue_filters"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="@dimen/spacing_tight"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_filter_all"
                    style="@style/Widget.Urbanfix.FilterButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_filter_all" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_filter_roads"
                    style="@style/Widget.Urbanfix.FilterButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_filter_roads" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_filter_greenery"
                    style="@style/Widget.Urbanfix.FilterButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_filter_greenery" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_filter_investments"
                    style="@style/Widget.Urbanfix.FilterButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_filter_investments" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </HorizontalScrollView>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/inputLayoutHomeStatusFilter"
            style="@style/Widget.Urbanfix.TextInput.Outlined.ExposedDropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_block"
            android:hint="@string/home_status_filter_hint"
            app:hintTextAppearance="@style/TextAppearance.Urbanfix.InputHint">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/dropdownHomeStatusFilter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:minHeight="@dimen/input_min_height"
                android:paddingVertical="@dimen/spacing_tight"
                android:textSize="16sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <ProgressBar
            android:id="@+id/progress_home_issues"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/spacing_section"
            android:visibility="gone" />

        <TextView
            android:id="@+id/text_home_issues_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_section"
            android:paddingHorizontal="@dimen/spacing_tight"
            android:textAppearance="@style/TextAppearance.Urbanfix.Body"
            android:visibility="gone"
            tools:text="Brak zgłoszeń." />

        <ScrollView
            android:id="@+id/scroll_home_issues"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/spacing_element"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="96dp">

                <LinearLayout
                    android:id="@+id/container_home_stats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_section"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/text_home_issues_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_section"
                    android:paddingHorizontal="@dimen/spacing_tight"
                    android:text="@string/home_stats_section_issues"
                    android:textAppearance="@style/TextAppearance.Urbanfix.Title"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/container_home_issues"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="@dimen/spacing_block" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_create_issue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/spacing_screen_horizontal"
        android:layout_marginBottom="@dimen/spacing_screen_bottom"
        android:contentDescription="@string/home_create_issue"
        app:srcCompat="@android:drawable/ic_input_add" />
</FrameLayout>
