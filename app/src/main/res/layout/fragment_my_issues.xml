<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/spacing_screen_horizontal"
    android:paddingTop="@dimen/spacing_screen_vertical"
    android:paddingBottom="@dimen/spacing_screen_bottom">

    <ProgressBar
        android:id="@+id/progress_my_issues"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/dashboard_content_top_spacing"
        android:visibility="gone" />

    <TextView
        android:id="@+id/text_my_issues_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dashboard_content_top_spacing"
        android:paddingHorizontal="@dimen/spacing_tight"
        android:text="@string/my_issues_empty"
        android:textAppearance="@style/TextAppearance.Urbanfix.Body"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/scroll_my_issues"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/spacing_element"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/container_my_issues"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/issue_list_container_padding_bottom" />
    </ScrollView>
</LinearLayout>
